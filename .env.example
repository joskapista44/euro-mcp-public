# .env.example -- safe placeholders/defaults only. Never commit real credentials.

# --- MCP server ---
PORT=3000

# --- DocBuilder job transport (runner.cjs) ---
EURO_EXEC=ssh
EURO_SSH_HOST=your-docbuilder-box.example.com
EURO_SSH_USER=your-ssh-user
EURO_SSH_KEY_PATH=/path/to/your/private_key
# Optional external vault integration used only when EURO_SSH_KEY_PATH is unset.
EURO_VAULT_ROOT=
EURO_VAULT_KEY=ssh_host
EURO_TIMEOUT_MS=90000
EURO_BOX_IP=172.22.0.1

# --- caller identity for audit/trace context ---
EURO_AGENT_ID=changeme-caller-id

# --- live co-editing path ---
EURO_COEDIT_AGENTS=changeme-comma-separated-allowlist
EURO_COEDIT_NC_URL=https://your-nextcloud.example.com
# Optional path to a separately installed Playwright package.
EURO_PLAYWRIGHT_PATH=
# Per-agent Nextcloud app password. Replace CHANGEME with the agent name in uppercase.
CHANGEME_NEXTCLOUD_APP_PASSWORD=changeme-app-password

# --- box-helper.py: box-side Document Server / DocBuilder configuration ---
# These values are read on the Euro-Office box, so normally they live in that box's own env.
EO_DS_URL=http://127.0.0.1:8081
EO_ENV_FILE=/path/to/your/box/env-file

# --- capability/trace diagnostics ---
EURO_TRACE_LOG_DIR=/path/to/a/writable/log/dir
