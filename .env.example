# .env.example -- variable names + safe placeholders/defaults only. NO real credential goes here.
# Built from the `process.env.*` names actually read by the code in this repository (verified:
# every EURO_*/OFFICE_*/PORT key below has a matching `process.env.<KEY>` or `os.environ.get(<KEY>)`
# call). Copy to .env and fill in the values your deployment needs -- most have a working default
# and only need overriding if your setup differs from it.

# --- MCP server ---
PORT=3000

# --- euro-mcp.cjs: the DocBuilder job transport (runner.cjs) ---
EURO_EXEC=ssh
# ssh transport target (only used when EURO_EXEC=ssh, the default)
EURO_SSH_HOST=your-docbuilder-box.example.com
EURO_SSH_USER=your-ssh-user
# Private key for the ssh transport. Point this at a plain key file -- no vault integration
# required. (There is a second, optional path via EURO_VAULT_ROOT below; ignore it unless you
# already have that integration.)
EURO_SSH_KEY_PATH=/path/to/your/private_key
# Only used if EURO_SSH_KEY_PATH is unset: points at an external deployment that provides
# <root>/dist/web/vault.js exporting getSecret(name, callerId). Nothing in this repository
# provides that module -- leave unset unless you have your own.
EURO_VAULT_ROOT=
# Name under which the key above is looked up, if you do use EURO_VAULT_ROOT's vault path.
EURO_VAULT_KEY=ssh_host
EURO_TIMEOUT_MS=90000
EURO_BOX_IP=172.22.0.1

# --- euro-mcp.cjs: caller identity (used in audit/trace output, not authorization) ---
EURO_AGENT_ID=changeme-caller-id

# --- coedit.cjs: the co-editing (live Document Server session) write path ---
EURO_COEDIT_AGENTS=changeme-comma-separated-allowlist
# Deliberately separate from OFFICE_DS_URL below -- an accidentally-inherited value here would
# write probe documents into whatever instance it points at.
EURO_COEDIT_NC_URL=https://your-nextcloud.example.com
# Optional: a separately-installed playwright, if the normal `require('playwright')` resolution
# does not find one. playwright itself is NOT a declared dependency of this project (see README).
EURO_PLAYWRIGHT_PATH=
# Per-agent Nextcloud password, keyed by the agent name in ALL CAPS (e.g. AGENTNAME_NEXTCLOUD_APP_PASSWORD
# for an agent named "agentname"). This is the only credential source coedit.cjs reads -- there is no fallback.
CHANGEME_NEXTCLOUD_APP_PASSWORD=changeme-app-password

# --- box-helper.py: the DocBuilder job runner (on the box EURO_SSH_HOST points at -- these two
# are read on the BOX SIDE, so they belong in that box's own env file, not necessarily here) ---
EO_DS_URL=http://127.0.0.1:8081
EO_ENV_FILE=/path/to/your/box/env-file

# --- office-mcp.js / office_*.py: the standalone (no live session) toolkit ---
OFFICE_DS_URL=https://your-nextcloud.example.com
OFFICE_DS_JWT=changeme-document-server-jwt
OFFICE_DS_TIMEOUT_MS=30000
# docker:<image>  -- run soffice in a container (OFFICE_IMAGE picks the default image tag)
# host            -- run a host soffice binary directly (OFFICE_SOFFICE_BIN overrides the path)
OFFICE_ENGINE=host
OFFICE_IMAGE=your-org/office-lo:1
OFFICE_SOFFICE_BIN=
# Colon-separated allow-list of absolute path prefixes the office tools may touch. Widen this
# deliberately; do not edit office_paths.py to do the same thing.
OFFICE_ALLOWED_ROOTS=/tmp

# --- capabilities-registry-build.mjs / capability-status-model.mjs diagnostics ---
EURO_TRACE_LOG_DIR=/path/to/a/writable/log/dir
